{
    "name": "johnburnout/filenavigator",
    "description": "Gestionnaire de fichiers pour WordPress (shortcode [filenavigator])",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "symfony/finder": "^6.4",
        "symfony/filesystem": "^6.4.50",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "WPFN\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPFN\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    }
}
