<div class="wpfb-filebrowser" 
     data-root="{{ root_path }}" 
     data-ajaxurl="{{ ajax_url }}" 
     data-nonce="{{ nonce }}"
     style="width: {{ container_width }}; height: {{ container_height }}; max-height: {{ container_height }}; overflow: auto; box-sizing: border-box;">
    <!-- Barre d'outils -->
    <div class="wpfb-toolbar">
        {% if permissions.can_upload %}
            <button class="wpfb-btn wpfb-btn-upload" title="Uploader des fichiers">⬆️ UL</button>
            <input type="file" id="wpfb-upload-input" multiple style="display:none;">
        {% endif %}
        {% if permissions.can_download %}
            <button class="wpfb-btn wpfb-btn-download" title="Télécharger les fichiers sélectionnés">⬇️ DL</button>
        {% endif %}
        {% if permissions.can_copy %}
            <button class="wpfb-btn wpfb-btn-copy" title="Copier les fichiers sélectionnés">📋 Copier</button>
        {% endif %}
        {% if permissions.can_cut %}
            <button class="wpfb-btn wpfb-btn-cut" title="Couper les fichiers sélectionnés">✂️ Couper</button>
        {% endif %}
        {% if permissions.can_paste %}
            <button class="wpfb-btn wpfb-btn-paste" title="Coller (copier ou déplacer)">📎 Coller</button>
        {% endif %}
        {% if permissions.can_rename %}
            <button class="wpfb-btn wpfb-btn-rename" title="Renommer le fichier sélectionné">✏️ Renommer</button>
        {% endif %}
        {% if permissions.can_mkdir %}
            <button class="wpfb-btn wpfb-btn-mkdir" title="Créer un nouveau dossier">📁 Nouveau dossier</button>
        {% endif %}
        {% if permissions.can_delete %}
            <button class="wpfb-btn wpfb-btn-delete" title="Supprimer les fichiers sélectionnés">🗑️ Supprimer</button>
        {% endif %}
        <!-- Tri -->
        <span class="wpfb-sort-group">
            <label for="wpfb-sort-select">Trier par</label>
            <select id="wpfb-sort-select" class="wpfb-sort-select">
                <option value="name" {{ current_sort == 'name' ? 'selected' : '' }}>Nom</option>
                <option value="size" {{ current_sort == 'size' ? 'selected' : '' }}>Taille</option>
                <option value="mtime" {{ current_sort == 'mtime' ? 'selected' : '' }}>Date</option>
            </select>
            <select id="wpfb-order-select" class="wpfb-order-select">
                <option value="asc" {{ current_order == 'asc' ? 'selected' : '' }}>↗️</option>
                <option value="desc" {{ current_order == 'desc' ? 'selected' : '' }}>↘️</option>
            </select>
        </span>
        <span class="wpfb-status" id="wpfb-status"></span>
        <span id="wpfb-clipboard-indicator" style="display:none; margin-left:10px; color:#0073aa;">📋 Contenu du presse-papiers</span>
    </div>

    <!-- Breadcrumb -->
    <div class="wpfb-breadcrumb">
        {% for crumb in breadcrumb %}
            {% if not loop.first %} / {% endif %}
            <a href="{{ add_query_arg('fb_dir', crumb.path)|esc_url }}">{{ crumb.label|e }}</a>
        {% endfor %}
    </div>

    <!-- Liste -->
    <ul class="wpfb-list">
        {% for item in items %}
            <li class="wpfb-item {{ item.isDir ? 'is-dir' : 'is-file' }}" 
                data-path="{{ item.relative|e }}" 
                data-is-dir="{{ item.isDir ? 'true' : 'false' }}">
                
                <input type="checkbox" class="wpfb-item-checkbox" data-path="{{ item.relative|e }}">
                
                {% if item.isDir %}
                    {# Dossier : lien cliquable #}
                    <a href="{{ add_query_arg('fb_dir', item.relative)|esc_url }}" class="wpfb-item-link">
                        <span class="wpfb-item-icon">📁</span>
                        <span class="wpfb-item-name">{{ item.name|e }}</span>
                    </a>
                {% else %}
                    {# Fichier : affichage avec icône ou vignette #}
                    {% set ext = item.name|split('.')|last|lower %}
                    {% set file_url = item.relative|wpfb_file_url(root_path) %}
                    
                    <span class="wpfb-item-content">
                        {% if ext in ['jpg', 'jpeg', 'png', 'gif', 'webp'] %}
                            <span class="wpfb-thumbnail-wrapper">
                                <img src="{{ file_url }}" alt="{{ item.name }}" class="wpfb-thumbnail">
                                <span class="wpfb-thumbnail-zoom">
                                    <img src="{{ file_url }}" alt="Aperçu">
                                </span>
                            </span>
                        {% elseif ext == 'pdf' %}
                            <span class="wpfb-item-icon wpfb-pdf-icon">📑</span>
                        {% else %}
                            <span class="wpfb-item-icon">📄</span>
                        {% endif %}
                        <span class="wpfb-item-name">{{ item.name|e }}</span>
                    </span>
                    <span class="wpfb-item-size">({{ item.size|size_format }})</span>
                    <span class="wpfb-item-date">{{ date_i18n('d/m/Y H:i', item.mtime) }}</span>
                {% endif %}
                
                <!-- Champ de renommage (caché) -->
                <span class="wpfb-rename-wrapper" style="display:none;">
                    <input type="text" class="wpfb-rename-input" value="{{ item.name|e }}">
                    <button class="wpfb-rename-confirm">✅</button>
                    <button class="wpfb-rename-cancel">❌</button>
                </span>
            </li>
        {% else %}
            <li class="wpfb-empty">Aucun fichier ou dossier trouvé.</li>
        {% endfor %}
    </ul>
</div>